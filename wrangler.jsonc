{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eray-site",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "build": {
    "command": "npm run build",
    "watch_dir": ["index.html", "styles.css", "script.js", "scripts/build.mjs"]
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  }
}
