{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eray-site",
  "compatibility_date": "2025-09-01",
  "main": "worker/index.js",
  "workers_dev": true,
  "build": {
    "command": "npm run build",
    "watch_dir": [
      "index.html",
      "styles.css",
      "script.js",
      "robots.txt",
      "sitemap.xml",
      "llms.txt",
      "indexnow-key.txt",
      "scripts/build.mjs",
      "stt-demo",
      "balbal",
      "balbal-v1",
      "balbal-blog",
      "redirects",
      "worker",
    ],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Only /petville and /api/* run the Worker; everything else is served straight from assets.
    "run_worker_first": ["/petville", "/petville/*", "/api/*"],
  },
  // contact form submissions (/api/contact), one JSON record per message
  "kv_namespaces": [{ "binding": "CONTACT_SUBMISSIONS", "id": "da73b216e7b04d6382425ad2b613ec2f" }],
  // at most 5 form posts per minute per IP
  "ratelimits": [{ "name": "CONTACT_LIMIT", "namespace_id": "1029", "simple": { "limit": 5, "period": 60 } }],
}
