{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eray-site",
  "compatibility_date": "2025-09-01",
  "main": "worker/index.js",
  "workers_dev": true,
  "build": {
    "command": "npm run build",
    "watch_dir": [
      "index.html",
      "styles.css",
      "script.js",
      "scripts/build.mjs",
      "stt-demo",
      "balbal",
      "balbal-v1",
      "balbal-blog",
      "redirects",
      "worker",
    ],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Only /petville runs the Worker; everything else is served straight from assets.
    "run_worker_first": ["/petville", "/petville/*"],
  },
}
